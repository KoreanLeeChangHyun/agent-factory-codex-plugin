{
  "description": "Block direct LLM authoring of canonical Agent Factory Artifact JSON.",
  "hooks": {
    "PreToolUse": [
      {
        "hooks": [
          {
            "command": "python3 \"$PLUGIN_ROOT/hooks/artifact_json_guard.py\" hook",
            "statusMessage": "Checking canonical Artifact JSON authoring",
            "timeout": 5,
            "type": "command"
          }
        ],
        "matcher": "^(Bash|apply_patch|Edit|Write)$"
      }
    ]
  }
}
