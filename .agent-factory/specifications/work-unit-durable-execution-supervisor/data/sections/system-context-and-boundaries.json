{
  "id": "system-context-and-boundaries",
  "title": "System Context and Boundaries",
  "content": [
    {
      "id": "SYSTEM-CONTEXT-001",
      "kind": "system-context",
      "content": {
        "participants": [
          "Human",
          "work-unit-execution controller",
          "Codex exec session",
          "Work Unit manager",
          "Git"
        ],
        "dependencies": [
          "codex exec",
          "codex exec resume",
          "canonical Work Unit JSON",
          "persistent Goal",
          "dedicated Git worktree"
        ]
      }
    },
    {
      "id": "GUARANTEE-BOUNDARY-001",
      "kind": "boundaries",
      "content": {
        "guaranteed": [
          "불완전 Work Unit은 exec 시작 전에 거부",
          "admitted execution은 중간 interview 없이 terminal state까지 controller가 구동",
          "조기 exec 종료 시 정확한 동일 세션 ID로 resume"
        ],
        "notGuaranteed": [
          "완전 무중단",
          "호스트·디스크·세션 저장소 손실",
          "분산 failover",
          "외부 side effect exactly-once"
        ]
      }
    }
  ],
  "subsections": []
}
