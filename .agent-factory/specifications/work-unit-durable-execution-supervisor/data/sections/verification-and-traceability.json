{
  "id": "verification-and-traceability",
  "title": "Verification and Traceability",
  "content": [
    {
      "id": "VERIFICATION-STRATEGY-001",
      "kind": "verification-strategy",
      "content": {
        "commands": [
          "codex exec resume --help",
          "python3 skills/specification/scripts/specification.py validate .agent-factory/specifications/work-unit-durable-execution-supervisor --full",
          "python3 skills/intake/scripts/intake.py validate .agent-factory/intakes/work-unit-durable-control-plane --full",
          "rg -n \"codexSessionId|codex exec resume|--last|--ephemeral|terminal\" .agent-factory/intakes/work-unit-durable-control-plane .agent-factory/specifications/work-unit-durable-execution-supervisor"
        ],
        "semanticChecks": [
          "Exact recorded session ID is the only resume target.",
          "No active SQLite, WAL, lease or fencing dependency remains.",
          "No Human interview occurs after admission.",
          "Execution converges to review-ready or terminal failure."
        ]
      }
    },
    {
      "id": "TRACEABILITY-001",
      "kind": "traceability",
      "content": {
        "intakeAnchor": ".agent-factory/intakes/work-unit-durable-control-plane#work-unit-basis",
        "mappings": [
          "Admission -> REQUIREMENT-ADMISSION-001, ACCEPTANCE-ADMISSION-001",
          "Session capture and resume -> REQUIREMENT-STATE-003, REQUIREMENT-RECOVERY-004, ACCEPTANCE-SESSION-010",
          "No mid-execution interview -> REQUIREMENT-CONTINUATION-011, ACCEPTANCE-CONTINUATION-011",
          "Terminal convergence -> REQUIREMENT-FAILURE-012, ACCEPTANCE-TERMINAL-006"
        ]
      }
    },
    {
      "id": "REVIEW-STATUS-001",
      "kind": "review-status",
      "content": {
        "status": "aligned",
        "aiVerification": "Specification manager validation and exact CLI parser evidence required.",
        "humanStatus": "accepted",
        "note": "Human accepted session-targeted resume controller instead of SQLite-centric durability."
      }
    }
  ],
  "subsections": []
}
