{
  "id": "admission-execution-and-recovery",
  "title": "Admission, Execution and Recovery",
  "content": [
    {
      "id": "ADMISSION-CHECKS-001",
      "kind": "admission",
      "content": {
        "checks": [
          "Work Unit is full-valid and ready.",
          "Goal matches Work Unit.",
          "Execution context, permissions, tools, verification and Human decisions are complete.",
          "No active controller or session target conflicts."
        ],
        "refusalEffects": [
          "No branch or worktree creation.",
          "No attempt start.",
          "No codex exec session creation."
        ]
      }
    },
    {
      "id": "ADMISSION-ORDER-001",
      "kind": "fail-closed-order",
      "content": {
        "sequence": [
          "validate",
          "resolve-decisions",
          "verify-permissions",
          "verify-tools",
          "admit",
          "create-goal",
          "prepare",
          "start-attempt",
          "start-exec"
        ]
      }
    },
    {
      "id": "EXECUTION-FLOW-001",
      "kind": "execution",
      "content": {
        "sequence": [
          "start codex exec without --ephemeral",
          "capture exact session UUID",
          "record codexSessionId",
          "monitor canonical terminal state",
          "on nonterminal exit call codex exec resume <SESSION_ID>",
          "repeat without Human interview",
          "emit review-ready or terminal failure evidence"
        ]
      }
    },
    {
      "id": "SESSION-RECOVERY-001",
      "kind": "recovery",
      "content": {
        "recoverySteps": [
          "read active Work Unit execution-state",
          "resolve exact codexSessionId",
          "refuse missing or ambiguous session ID",
          "resume the same session with continuation prompt",
          "verify unchanged revision, attempt and head"
        ],
        "claimRules": [
          "One controller per active attempt.",
          "Never select --last.",
          "Never replace the session silently."
        ]
      }
    },
    {
      "id": "RETRY-TERMINAL-001",
      "kind": "retry-and-terminal",
      "content": {
        "items": [
          "Retry recoverable exec exits by resuming the same session.",
          "Do not ask the Human during active execution.",
          "If exact resume is impossible, record evidence-backed terminal failure.",
          "Human review begins only after review-ready or terminal failure."
        ]
      }
    }
  ],
  "subsections": []
}
