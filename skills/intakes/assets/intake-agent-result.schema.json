{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agent-factory.local/schema/intake-agent-result.schema.json",
  "title": "Agent Factory Intake Agent Result",
  "type": "object",
  "additionalProperties": false,
  "required": ["status", "summary", "question", "evidence", "limitations"],
  "properties": {
    "status": {"type": "string", "enum": ["completed", "needs-human-decision", "failed"]},
    "summary": {"type": "string", "minLength": 1, "maxLength": 4000},
    "question": {"type": ["string", "null"], "maxLength": 2000},
    "evidence": {"type": "array", "items": {"type": "string", "maxLength": 1000}, "maxItems": 100},
    "limitations": {"type": "array", "items": {"type": "string", "maxLength": 1000}, "maxItems": 100}
  }
}
