{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agent-factory.local/schemas/intake/v3/metadata.schema.json",
  "title": "Agent Factory Intake Ledger Metadata",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion", "documentVersion", "id", "artifactType", "projectId",
    "topic", "createdAt", "updatedAt", "language", "provenance", "relations"
  ],
  "properties": {
    "schemaVersion": {"const": "3.0.0"},
    "documentVersion": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"},
    "id": {"type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"},
    "artifactType": {"const": "intake"},
    "projectId": {"type": "string", "minLength": 1},
    "topic": {"type": "string", "minLength": 1},
    "createdAt": {"type": "string", "format": "date-time"},
    "updatedAt": {"type": "string", "format": "date-time"},
    "language": {"type": "string", "minLength": 2},
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["createdBy", "generatedBy", "sourceRefs"],
      "properties": {
        "createdBy": {"type": "string", "minLength": 1},
        "generatedBy": {"type": "string", "minLength": 1},
        "sourceRefs": {"$ref": "#/$defs/typedRefs"}
      }
    },
    "relations": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["type", "target"],
        "properties": {
          "type": {"type": "string", "pattern": "^[a-z][a-z0-9-]*$"},
          "target": {"$ref": "#/$defs/typedRef"}
        }
      }
    },
    "operational": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "agentSessionBinding": {
          "type": "object",
          "additionalProperties": false,
          "required": ["sessionId"],
          "properties": {
            "sessionId": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"}
          }
        }
      }
    }
  },
  "$defs": {
    "typedRef": {
      "type": "object",
      "additionalProperties": false,
      "required": ["artifactType", "id", "path"],
      "properties": {
        "artifactType": {"type": "string", "pattern": "^[a-z][a-z0-9-]*$"},
        "id": {"type": "string", "minLength": 1},
        "path": {"type": "string", "minLength": 1}
      }
    },
    "typedRefs": {"type": "array", "items": {"$ref": "#/$defs/typedRef"}}
  }
}
