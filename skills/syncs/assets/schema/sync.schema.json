{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Agent Factory project sync configuration",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "sources"
  ],
  "properties": {
    "schemaVersion": {
      "const": "1.0.0"
    },
    "sources": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "google-drive": {
          "$ref": "#/$defs/source"
        },
        "google-gmail": {
          "$ref": "#/$defs/source"
        }
      }
    }
  },
  "$defs": {
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "destination"
      ],
      "properties": {
        "destination": {
          "type": "string",
          "minLength": 1
        }
      }
    }
  }
}
