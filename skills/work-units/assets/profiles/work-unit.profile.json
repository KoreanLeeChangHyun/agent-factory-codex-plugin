{
  "id": "work-unit",
  "version": "4.0.0",
  "artifactType": "work-unit",
  "documentClass": "execution-unit",
  "maximumSectionDepth": 2,
  "commonRequiredSections": [],
  "profileRequiredSections": [
    {"id": "basis", "title": "Basis", "requiredKinds": ["intake-basis-ref"], "contains": ["Intake and Specification references", "requirement and decision references", "relevant evidence", "Specification check requirement"]},
    {"id": "work-definition", "title": "Work Definition", "requiredKinds": ["goal", "scope", "out-of-scope", "expected-output"], "contains": ["single goal", "scope and exclusions", "constraints and assumptions", "dependencies and order", "expected output"]},
    {"id": "plan", "title": "Plan", "requiredKinds": ["plan-step"], "contains": ["implementation-only Workflow Agent", "optional Human-authorized Test Agent", "mandatory affected-document Documentation Agent", "runtime actions"]},
    {"id": "execution-context", "title": "Execution Context", "requiredKinds": ["execution-context"], "contains": ["Goal id and objective", "exec reference", "execution agent", "repository and local factory base and target", "execution mode", "optional derived branch and linked worktree identity", "versioned execution state and attempt history"]},
    {"id": "acceptance-and-verification", "title": "Acceptance and Verification", "requiredKinds": ["acceptance-criterion", "definition-of-done", "test-criterion", "quality-check"], "contains": ["acceptance criteria", "Definition of Done", "conditional test criteria that record exact Human-requested tests or no tests authorized", "quality gate", "required evidence"]},
    {"id": "execution", "title": "Execution", "requiredKinds": ["execution-result"], "contains": ["implementation result", "optional test result or tests not run", "mandatory documentation result", "role-specific failures", "changed artifacts", "deviations"]},
    {"id": "ai-review", "title": "AI Review", "requiredKinds": ["ai-checklist", "ai-review-result"], "contains": ["AI checklist", "scope and instruction compliance", "verification result", "remaining risks"]},
    {"id": "human-review", "title": "Human Review", "requiredKinds": ["human-checklist", "human-review-method", "human-review-result"], "contains": ["Human checklist", "inspection method", "rework and complete criteria", "automatic integration and Human-decided PR promotion boundaries"]},
    {"id": "report", "title": "Report", "requiredKinds": ["report-result"], "contains": ["execution summary", "normalized integration result and registered raw receipt when integration occurs", "artifact and evidence references", "Human-explicit verification result or tests not run", "Specification result", "remaining risks and unresolved items"]}
  ],
  "optionalSections": [
    {"id": "rework-history", "title": "Rework History", "contains": ["rework requests and results"]},
    {"id": "release-or-deployment", "title": "Release or Deployment", "contains": ["release or deployment actions and evidence"]}
  ],
  "blockGuidance": "Use registered blocks for large logs, screenshots, and non-JSON execution evidence.",
  "storageContract": "sectioned-document-package-v2",
  "implementationStatus": "implemented"
}
